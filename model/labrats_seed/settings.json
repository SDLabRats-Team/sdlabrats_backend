  "blocks": {
    "afterschool_session": "<p>Each session is two hours. A real scientist leads a one-hour, hands-on science lab, with a new lesson every week. Then kids get an hour of maker space with the freedom to build, create, or explore the topics that interest them most.</p>",
    "camp_why": "<section class=\"labrats__section\" aria-labelledby=\"camp-why\">\n  <h2 id=\"camp-why\">Why families pick LabRats camps</h2>\n  <div class=\"labrats__split\">\n    <div>\n      <h3>For parents</h3>\n      <p>The curriculum is written by working scientists and engineers who know how to make hard ideas approachable. Camps build on the NGSS topics kids cover in public and charter school. Along the way, kids practice:</p>\n      <ul class=\"labrats__list\">\n        <li>Spatial reasoning and design</li>\n        <li>Sticking with a problem when the first try fails</li>\n        <li>Confidence that they can build a working solution</li>\n      </ul>\n    </div>\n    <div>\n      <h3>For kids</h3>\n      <p>Campers get to design their own solutions and see their ideas come to life. They love:</p>\n      <ul class=\"labrats__list\">\n        <li>Making a mess in hands-on labs</li>\n        <li>Solving challenges in their own way</li>\n        <li>Free time in the maker space to chase their own projects</li>\n      </ul>\n    </div>\n  </div>\n</section>",
    "help_paying_families": "<section class=\"labrats__section labrats__band\" aria-labelledby=\"help-paying-title\">\n  <h2 id=\"help-paying-title\">Help paying</h2>\n  \n  <div class=\"labrats__split\">\n    <div>\n      <h3>Scholarships</h3>\n      <p>Up to 75% off afterschool classes and up to 50% off camps for households earning under $89,000 a year and military families. Scholarships are funded by our community.</p>\n      <p><a class=\"labrats__lede-link\" href=\"/scholarships/\">Apply for a scholarship</a></p>\n    </div>\n    <div>\n      <h3>Charter school funds</h3>\n      <p>LabRats is an approved vendor for many California charter schools, so homeschool and independent-study families can use their educational funds at the STEM Discovery Center.</p>\n      <p><a class=\"labrats__lede-link\" href=\"/about-us/#charter\">Check your charter school</a></p>\n    </div>\n  </div>\n  \n</section>",
    "help_paying_schools": "<section class=\"labrats__section labrats__band\" aria-labelledby=\"help-paying-title\">\n  <h2 id=\"help-paying-title\">Help paying</h2>\n  \n  <p>If a program is outside your school's or group's budget, several San Diego foundations and county grant programs fund STEM visits for underserved students.</p>\n  <p><a class=\"labrats__lede-link\" href=\"/scholarships/#grants\">See grants for schools and groups</a></p>\n  \n</section>",
    "questions": "<section class=\"labrats__section\" aria-labelledby=\"questions-title\">\n  <h2 id=\"questions-title\">Questions?</h2>\n  <p>Call us at <a data-labrats-org-href=\"{phone_href}\"><span data-labrats-org=\"phone\"></span></a> or <a href=\"/contact/\">send us a message</a>.</p>\n</section>",
    "footer_about": "<p><span data-labrats-org=\"tagline\"></span> to kids in grades K-8 across San Diego County.</p>\n<p>A <span data-labrats-org=\"nonprofit\"></span>. EIN <span data-labrats-org=\"ein\"></span>.</p>\n<p><a data-labrats-org-href=\"{impact_report}\">Read our 2023-24 impact report (PDF)</a></p>",
    "footer_signup": "<h2 id=\"footer-signup-title\">Get class and camp updates</h2>\n<p>New sessions, camp dates, and events. A few emails a month at most.</p>"
  },
